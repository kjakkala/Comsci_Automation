# Copy this file to .env and fill in real values. Never commit .env to source control.

# --- Web Application Under Test ---
BASE_URL=https://qa.itcostcontrol.com/automation/
LOGIN_USERNAME=your_username
LOGIN_PASSWORD=your_password

# --- Playwright Browser Settings ---
BROWSER=chromium
HEADLESS=true
UI_ACTION_TIMEOUT_MS=30000

# --- SQL Server Connection (fill in once DB access is granted) ---
DB_SERVER=
DB_NAME=
# Leave DB_USER/DB_PASSWORD blank to use Windows Authentication
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=1

# --- TestRail Dashboard Mapping ---
# Example: https://upland.testrail.com/index.php?/cases/view/{case_id}
TESTRAIL_CASE_URL_TEMPLATE=https://upland.testrail.com/index.php?/cases/view/{case_id}

# --- TestRail Run Integration (Comsci project) ---
TESTRAIL_ENABLE_ON_RUN=1
TESTRAIL_URL=https://upland.testrail.com
TESTRAIL_EMAIL=your_email@example.com
TESTRAIL_API_KEY=your_api_key
# Comsci project id - confirm and fill in
TESTRAIL_PROJECT_ID=
TESTRAIL_MILESTONE_ID=
# Known from provided TestRail suite URL
TESTRAIL_SUITE_ID=64174

# --- Reverse proxy base path (set only when hosted behind IIS under a sub-path) ---
# Example: APP_BASE_PATH=/ComsciAutomation
APP_BASE_PATH=
